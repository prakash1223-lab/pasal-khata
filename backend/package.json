{
  "name": "pasal-khata-backend",
  "version": "1.0.0",
  "description": "Backend API for Pasal Khata - Digital Khata System for Nepal",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start":            "node src/server.js",
    "dev":              "nodemon src/server.js",
    "migrate":          "node src/migrations/run.js",
    "migrate:supabase": "node src/migrations/run-supabase.js",
    "seed":             "node src/seeds/seed.js",
    "cleanup":          "node src/scripts/cleanup-seed-data.js",
    "cleanup:yes":      "node src/scripts/cleanup-seed-data.js --yes",
    "verify":           "node src/scripts/verify-data.js",
    "backup":           "node src/scripts/backup.js",
    "backup:list":      "node src/scripts/backup.js list",
    "restore":          "node src/scripts/restore.js",
    "setup-db":         "node src/scripts/setup-database.js",
    "pre-deploy":       "node src/scripts/pre-deploy-check.js"
  },
  "keywords": [
    "pasal-khata",
    "nepal",
    "khata",
    "shop-management"
  ],
  "author": "Pasal Khata",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
